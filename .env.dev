APP_ENV=dev
APP_SECRET=1d727be5cdbb7cb93e2846c1866ae5a6

KERNEL_CLASS='App\Kernel'

DEFAULT_URI=http://localhost

###> image description ###
# The GenerateDescriptionHandler gets an ImageDescriptionGenerator (ImageDescriptionGeneratorInterface).
# We can provide the ImageDescriptionGenerator here, valid options are in enum ImageDescriptionProvider.
# Available options: fake (default), ollama, anthropic.
# fake = random text, no network.
# ollama = local ai.
# anthropic = frontier ai.
#
# Important: when picking 'ollama' perform the following:
# Override in .env.local the env var IMAGE_DESCRIPTION_PROVIDER and build the container with: compose.ollama.yaml.
IMAGE_DESCRIPTION_PROVIDER=fake

# Only used when IMAGE_DESCRIPTION_PROVIDER=ollama.
OLLAMA_URL=http://ollama:11434

# qwen3-vl = The most powerful vision-language model
# https://ollama.com/library/qwen3-vl
OLLAMA_MODEL=qwen3-vl:4b-instruct

# deliver frontier-level performance at each size
# https://ollama.com/library/gemma4:e4b
#OLLAMA_MODEL=gemma4:e4b

# Most capable model that runs on a single GPU.
# https://ollama.com/library/gemma3:4b
#OLLAMA_MODEL=gemma3:4b
