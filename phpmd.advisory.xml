<?xml version="1.0"?>
<ruleset name="photo-gallery-server (advisory)"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Reported, but never fails the deployment (run with --ignore-violations-on-exit).</description>

    <rule ref="rulesets/cleancode.xml"></rule>
    <rule ref="rulesets/codesize.xml"></rule>
    <rule ref="rulesets/controversial.xml"></rule>
    <rule ref="rulesets/design.xml"></rule>
    <rule ref="rulesets/naming.xml">
        <exclude name="LongVariable"/>
        <exclude name="ShortVariable"/>
        <exclude name="LongClassName"/>
        <exclude name="LongMethodName"/>
    </rule>
    <rule ref="rulesets/unusedcode.xml">
        <exclude name="UnusedFormalParameter"/>
    </rule>

    <!-- The one that really matters. Default is 100 lines incl. blank lines: too loose to ever fire here. -->
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="20"/>
            <property name="ignore-whitespace" value="true"/>
        </properties>
    </rule>

    <!-- Tuned: 20 is too strict for constructor-injected services ($imageDescriptionGenerator = 25). -->
    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <property name="maximum" value="30"/>
        </properties>
    </rule>

    <!-- Tuned: $id and $io (SymfonyStyle) are universal conventions. -->
    <!-- Tuned: $em (EntityManagerInterface) is a Doctrine concern defined in AbstractIdGenerator. -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="exceptions" value="id,io,em"/>
        </properties>
    </rule>

    <rule ref="rulesets/unusedcode.xml/UnusedFormalParameter">
        <properties>
            <property name="exceptions" value="platform"/>
        </properties>
    </rule>

</ruleset>
